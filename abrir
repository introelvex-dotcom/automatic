function verificarPin() {
    const pinCorrecto = "1234"; // Cambia este PIN por el que uses
    const ingreso = document.getElementById("pinInput").value;
    const mensaje = document.getElementById("mensaje");

    if(ingreso === pinCorrecto) {
        mensaje.style.color = "green";
        mensaje.innerText = "¡PIN correcto! Abriendo puerta...";
        
        // AQUÍ ES CLAVE: Reemplaza con tu URL exacta de IFTTT
        const urlIfttt = 'https://maker.ifttt.com/trigger/bot%C3%B3n_/with/key/d1PDkpOOCwk8wCSHVvb1mH';

        // Enviamos la petición a IFTTT sin esperar respuesta estricta (no-cors previene bloqueos del navegador)
        fetch(urlIfttt, {
            method: 'POST',
            mode: 'no-cors'
        }).then(() => {
            console.log("Señal enviada a IFTTT");
        }).catch(error => {
            console.error("Error de conexión", error);
        });

    } else {
        mensaje.style.color = "red";
        mensaje.innerText = "PIN Incorrecto. Intente de nuevo.";
    }
}
